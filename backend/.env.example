# Required in production. Generate a long random value; never commit the real secret.
EVOLVEAI_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API.
EVOLVEAI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo accounts are convenient only for local development.
EVOLVEAI_SEED_DEMO_USERS=false
